{
	"name": "nfe-webapp",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --cwd apps/start dev",
		"build": "bun run --cwd apps/start build",
		"start": "bun run --cwd apps/start start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "bun run --cwd apps/start typecheck",
		"test": "bun run --cwd apps/start test",
		"smoke": "bun run --cwd apps/start smoke",
		"local": "bun run --cwd apps/start local",
		"prepare": "bun scripts/install-hooks.ts",
		"dev:start": "bun run --cwd apps/start dev",
		"build:start": "bun run --cwd apps/start build",
		"typecheck:start": "bun run --cwd apps/start typecheck",
		"smoke:start": "bun run --cwd apps/start smoke",
		"local:start": "bun run --cwd apps/start local"
	},
	"packageManager": "bun@1.3.14",
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"lefthook": "^2.2.2"
	}
}
