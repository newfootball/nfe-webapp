{
	"name": "@nfe/start",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --port 3501 --strictPort",
		"build": "vite build && bun run check:client",
		"typecheck": "tsc --noEmit",
		"start": "bun server.ts",
		"smoke": "playwright test",
		"check:client": "bun scripts/check-client.ts",
		"test": "bun test tests/*.test.ts",
		"lint": "bun ../../node_modules/@biomejs/biome/bin/biome check .",
		"auth:prepare": "bun scripts/auth-local.ts prepare",
		"auth:up": "bun scripts/auth-local.ts up",
		"auth:down": "bun scripts/auth-local.ts down",
		"auth:proof": "bun scripts/auth-proof.ts",
		"profile:prepare": "bun scripts/profile-local.ts prepare",
		"profile:up": "bun scripts/profile-local.ts up",
		"profile:down": "bun scripts/profile-local.ts down",
		"profile:proof": "bun scripts/profile-proof.ts"
	},
	"dependencies": {
		"@radix-ui/react-slot": "1.2.4",
		"@tanstack/react-query": "5.105.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"next-themes": "0.4.6",
		"node-appwrite": "31.1.0",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"tailwind-merge": "3.5.0",
		"tw-animate-css": "1.4.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.3.13",
		"@types/node": "24.10.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.1.2",
		"seroval": "1.7.3",
		"tailwindcss": "4.3.3",
		"typescript": "5.7.2",
		"vite": "8.3.5",
		"yaml": "2.8.1"
	}
}
