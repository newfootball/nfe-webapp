# Build context allowlist for apps/start/Dockerfile (Refs #64).
# The build context is the repository root; only apps/start enters the image.
# Tools, docs, env files and git stay out.
*
!apps/start

# Start: dependencies, build output, local runtimes, evidence and secrets.
apps/start/node_modules
apps/start/dist
apps/start/.tanstack
apps/start/.local-runtime
apps/start/.agents
apps/start/evidence
apps/start/local-runtime
apps/start/scripts/.*
apps/start/tests
apps/start/test-results
apps/start/playwright-report
apps/start/playwright.*.config.ts
apps/start/.env*
apps/start/Dockerfile

**/.DS_Store
**/.env
**/.env.*
